# ==============================================================================
# Gated Township Resident Management System - Backend Environment Template
# ==============================================================================
# Copy this file to '.env' or export these environment variables before running.
# Never commit real credentials to version control.
# ==============================================================================

# Server Configuration
PORT=8080
APP_ENV=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=township_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# JWT Authentication (for Phase 2 Auth module)
# 256-bit or 512-bit Base64-encoded secret key
JWT_SECRET=c29tZV9zdXBlcl9zZWNyZXRfa2V5X2Zvcl90b3duc2hpcF9tYW5hZ2VtZW50X3N5c3RlbV8yMDI2
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

