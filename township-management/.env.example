# ==============================================================================
# Township Management System — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR SECURE SECRETS
# NEVER COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Database Connection Variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=township_db
DB_USER=postgres
DB_PASSWORD=

# Security & Authentication Secrets
# JWT_SECRET must be a cryptographically random Base64 string of at least 256 bits (32+ bytes)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional Cloud Integrations
GEMINI_API_KEY=

# Server Ports
PORT=8080
VITE_PORT=5173

